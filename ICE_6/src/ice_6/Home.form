          <SubComponents>
            <Component class="javax.swing.JTextArea" name="jTextArea_introduction">
              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Welcome to the Stock Management System  &#xa;&#xa;This application is designed to help you efficiently manage and track your stock inventory. &#xa;Whether you&apos;re dispatching items, updating records, or simply viewing your stock, our system offers a user-friendly &#xa;interface to streamline your operations. &#xa;Features:      &#xa;&#x9;Registration/Login (Optional): Create an account or log in to access personalized features.     &#xa;&#x9;Dispatch Items: Easily input item details to dispatch stock from your inventory.     &#xa;&#x9;Custom/Stock Page: Manage your stock or customize this page to suit your business needs.     &#xa;&#x9;View Records: Display all current stock and past transactions in an organized, easy-to-read format.  &#xa;&#xa;Use the navigation menu to explore the different features and get started managing your inventory today!"/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
      </SubComponents>
